@@ -0,0 +1,178 @@
+"""
+工作流2 · AI 工具可靠性故障注入测试（7 项）
+
+验证 _http_get/_http_post 的重试治理语义：
+1. flaky500 后恢复 → GET 重试成功（恰好 2 次请求）
+2. 持续 500 → 重试耗尽后抛错（不无限等待）
+3. 404 → 不重试（业务性错误，1 次请求）
+4. 慢接口超时 → TransportError 快速失败（超时配置生效）
+5. 配置 retries=0 → 不重试
+6. POST 写操作 → 不重试（防重复下单）
+7. 调用方 try/except 降级 → 工具返回「这项信息暂时没查到」
+
+用法：python test_tool_reliability.py
+依赖：httpx（已装）
+"""
+
+import asyncio
+import json
+import threading
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+
+import httpx
+
+# 注入配置（避免依赖项目 .env）
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "services" / "ai-orchestrator"))
+
+from app.config import Settings  # noqa: E402
+
+# ── 可控故障 HTTP Server ──
+# 踩坑记录：mock server 的 500 响应必须带 body，否则 httpx 抛 RemoteProtocolError
+# 而不是可重试的 HTTPStatusError；keep-alive 下 POST 未读 body 会 ReadError，
+# 因此用 HTTP/1.0 + do_POST 显式读 Content-Length。
+
+STATE = {"mode": "ok", "count": 0, "delay": 0.0}
+
+
+class Handler(BaseHTTPRequestHandler):
+    protocol_version = "HTTP/1.0"
+
+    def _read_body(self):
+        n = int(self.headers.get("Content-Length", 0))
+        if n > 0:
+            self.rfile.read(n)
+
+    def log_message(self, *a):
+        pass
+
+    def _respond(self, status, body):
+        payload = body.encode("utf-8")
+        self.send_response(status)
+        self.send_header("Content-Type", "application/json")
+        self.send_header("Content-Length", str(len(payload)))
+        self.end_headers()
+        self.wfile.write(payload)
+
+    def do_GET(self):
+        STATE["count"] += 1
+        if STATE["delay"] > 0:
+            import time
+            time.sleep(STATE["delay"])
+        if STATE["mode"] == "flaky500" and STATE["count"] == 1:
+            self._respond(500, '{"err":"flaky"}')
+            return
+        if STATE["mode"] == "always500":
+            self._respond(500, '{"err":"always"}')
+            return
+        if STATE["mode"] == "notfound":
+            self._respond(404, '{"err":"not found"}')
+            return
+        self._respond(200, '{"data":{"ok":true}}')
+
+    def do_POST(self):
+        self._read_body()
+        STATE["count"] += 1
+        self._respond(200, '{"data":{"ok":true,"post":true}}')
+
+
+def start_server() -> ThreadingHTTPServer:
+    server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+    t = threading.Thread(target=server.serve_forever, daemon=True)
+    t.start()
+    return server
+
+
+async def main():
+    server = start_server()
+    base = f"http://127.0.0.1:{server.server_address[1]}"
+    results = []
+
+    def check(name, ok, detail):
+        results.append((name, ok, detail))
+        print(f"{'PASS' if ok else 'FAIL'} {name}: {detail}")
+
+    # 1. flaky500 → 重试成功
+    STATE.update(mode="flaky500", count=0, delay=0.0)
+    cfg = Settings(ai_tool_timeout_s=5.0, ai_tool_retries=1, ai_tool_retry_delay_s=0.05)
+    from app.tools import _http_get  # noqa: E402
+    try:
+        await _http_get(f"{base}/x", headers={})
+        check("flaky500 重试成功", STATE["count"] == 2, f"请求数={STATE['count']}")
+    except Exception as e:
+        check("flaky500 重试成功", False, f"异常: {e}")
+
+    # 2. 持续 500 → 重试耗尽抛错
+    STATE.update(mode="always500", count=0, delay=0.0)
+    try:
+        await _http_get(f"{base}/x", headers={})
+        check("持续500 重试耗尽抛错", False, "未抛错")
+    except httpx.HTTPStatusError as e:
+        check("持续500 重试耗尽抛错", STATE["count"] == 2, f"请求数={STATE['count']}（1原+1重试）err={e.response.status_code}")
+    except Exception as e:
+        check("持续500 重试耗尽抛错", False, f"异常类型不符: {type(e).__name__}: {e}")
+
+    # 3. 404 → 不重试
+    STATE.update(mode="notfound", count=0, delay=0.0)
+    try:
+        await _http_get(f"{base}/x", headers={})
+        check("404 不重试", False, "未抛错")
+    except httpx.HTTPStatusError:
+        check("404 不重试", STATE["count"] == 1, f"请求数={STATE['count']}")
+    except Exception as e:
+        check("404 不重试", False, f"异常类型不符: {type(e).__name__}")
+
+    # 4. 慢接口超时 → TransportError 快速失败
+    STATE.update(mode="ok", count=0, delay=1.0)
+    cfg_slow = Settings(ai_tool_timeout_s=0.2, ai_tool_retries=0, ai_tool_retry_delay_s=0.05)
+    from app.tools import _http_get as _get_with_cfg
+    import app.tools as tools_mod
+    old = tools_mod.settings
+    tools_mod.settings = cfg_slow
+    try:
+        await _get_with_cfg(f"{base}/x", headers={})
+        check("慢接口超时 TransportError", False, "未抛错")
+    except httpx.TransportError:
+        check("慢接口超时 TransportError", True, "TimeoutError/TransportError 快速失败")
+    except Exception as e:
+        check("慢接口超时 TransportError", False, f"异常类型: {type(e).__name__}")
+    finally:
+        tools_mod.settings = old
+
+    # 5. 配置 retries=0 → 不重试
+    STATE.update(mode="flaky500", count=0, delay=0.0)
+    cfg0 = Settings(ai_tool_timeout_s=5.0, ai_tool_retries=0, ai_tool_retry_delay_s=0.05)
+    tools_mod.settings = cfg0
+    try:
+        await _get_with_cfg(f"{base}/x", headers={})
+        check("retries=0 不重试", False, "未抛错")
+    except httpx.HTTPStatusError:
+        check("retries=0 不重试", STATE["count"] == 1, f"请求数={STATE['count']}")
+    except Exception as e:
+        check("retries=0 不重试", False, f"异常类型: {type(e).__name__}")
+    finally:
+        tools_mod.settings = old
+
+    # 6. POST 不重试（写操作防重复）
+    STATE.update(mode="ok", count=0, delay=0.0)
+    from app.tools import _http_post  # noqa: E402
+    await _http_post(f"{base}/create", {"a": 1}, headers={})
