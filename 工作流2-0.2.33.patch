+"""
+工作流2 · RAG 检索质量评测（ivfflat→HNSW 修复验证）
+
+前置：pgvector(zhigou_rag) 可连 + embedding API 可用（text-embedding-v4）。
+用例集：4 个真实查询（对应 products_vec 中 4 个已知商品）+ 2 个无关查询。
+输出：Top-1/Top-3 命中率、命中分数、无关查询分数 → 用于论证 min_score=0.50 阈值。
+
+实测基线（工作流2 记录）：
+- ivfflat(lists=100) 小数据退化：Top-1 命中率 0%（4 查询 3 空 1 错）
+- HNSW(m=16, ef_construction=64)：Top-1/Top-3 命中率 100%，分数 0.7905/0.7095/0.7025/0.785
+- 无关查询最高 0.3751 < 0.50 → 阈值过滤
+
+用法：python test_rag_quality.py
+依赖：asyncpg, openai；需设置 ZHIGOU_PG_DSN / ZHIGOU_LLM_API_KEY 等环境或项目 .env
+"""
+
+import asyncio
+import json
+import os
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "services" / "ai-orchestrator"))
+
+from app.config import settings  # noqa: E402
+from app.rag import service as rag_service  # noqa: E402
+from openai import AsyncOpenAI  # noqa: E402
+
+# ── 评测用例：query / 期望 spu_id ──
+CASES = [
+    ("轻量透气跑鞋", 9000000000000000010),
+    ("无线降噪蓝牙耳机", 9000000000000000011),
+    ("纯棉舒适的T恤", 9000000000000000012),
+    ("智能运动手表", 9000000000000000999),
+]
+UNRELATED = ["恐龙化石", "生鲜水果"]
+
+
+async def embed(text: str) -> list[float]:
+    client = AsyncOpenAI(base_url=settings.llm_base_url, api_key=settings.llm_api_key)
+    resp = await client.embeddings.create(model=settings.embedding_model, input=text)
+    return resp.data[0].embedding
+
+
+async def main():
+    # 索引类型检查（实证 HNSW 已生效）
+    await rag_service.init_db()
+    rows = await rag_service._fetch(
+        "SELECT indexname, indexdef FROM pg_indexes WHERE tablename='products_vec'"
+    )
+    print("== 索引清单 ==")
+    for r in rows:
+        print(f"  {r['indexname']}: {r['indexdef']}")
+    hnsw_ok = any("hnsw" in r["indexdef"].lower() for r in rows)
+    ivfflat_left = any("ivfflat" in r["indexdef"].lower() for r in rows)
+    print(f"  HNSW 生效={hnsw_ok}, ivfflat 残留={ivfflat_left}")
+
+    top1 = top3 = 0
+    hit_scores, unrelated_scores = [], []
+    details = []
+
+    for query, expected in CASES:
+        vec = await embed(query)
+        res = await rag_service.similarity_search(vec, top_k=5)
+        spus = [r.spu_id for r in res]
+        scores = [r.score for r in res]
+        hit1 = spus[:1] == [expected]
+        hit3 = expected in spus[:3]
+        top1 += hit1
+        top3 += hit3
+        if hit1:
+            hit_scores.append(scores[0])
+        details.append({
+            "query": query, "tag": "真实查询", "expected": expected,
+            "top1_hit": hit1, "top3_hit": hit3,
+            "top1_spu": spus[0] if spus else None, "top1_score": scores[0] if scores else None,
+            "top5_spus": spus, "top5_scores": scores,
+        })
+        print(f"  [{query}] top1_hit={hit1} top3_hit={hit3} scores={scores}")
+
+    for query in UNRELATED:
+        vec = await embed(query)
+        res = await rag_service.similarity_search(vec, top_k=3)
+        scores = [r.score for r in res]
+        if scores:
+            unrelated_scores.append(scores[0])
+        details.append({
+            "query": query, "tag": "无关查询", "expected": None,
+            "top1_hit": False, "top3_hit": False,
+            "top1_spu": res[0].spu_id if res else None,
+            "top1_score": scores[0] if scores else None,
+            "top5_spus": [r.spu_id for r in res], "top5_scores": scores,
+        })
+        print(f"  [{query}] 无关查询 top1_score={scores[0] if scores else '已滤空'}")
+
+    report = {
+        "top1_hit_rate": top1 / len(CASES),
+        "top3_hit_rate": top3 / len(CASES),
+        "hit_scores": hit_scores,
+        "unrelated_top1_scores": unrelated_scores,
+        "threshold_probe": {
+            "min_hit_score": min(hit_scores) if hit_scores else None,
+            "max_unrelated_score": max(unrelated_scores) if unrelated_scores else None,
+            "suggested_min_score": 0.50,
+        },
+        "cases": details,
+    }
+    print("\n===== RAG 评测报告 =====")
+    print(json.dumps(report, ensure_ascii=False, indent=2))
+    out = Path(__file__).resolve().parent / "rag_quality_result.json"
+    out.write_text(json.dumps(report, ensure_ascii=False, indent=2), encoding="utf-8")
+    print(f"\n结果已写入: {out}")
+    sys.exit(0)
+
+
+if __name__ == "__main__":
+    asyncio.run(main())
