+"""
+工作流2 · AI 防编造护栏回归测试（8 项）
+
+固化 _NOT_FOUND_MARKERS 15 词 + 空结果/异常护栏语义。
+真实漏洞：原关键词表缺「未搜索到」，search_products 的"未搜索到相关商品。"
+不触发护栏 → LLM 可对空结果自由编造。本测试保证补词后不再回归。
+
+用法：python test_forge_guard.py
+"""
+
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "services" / "ai-orchestrator"))
+
+from app.chat_service import _FORGE_GUARD, _NOT_FOUND_MARKERS, _guard_result  # noqa: E402
+
+
+def main():
+    results = []
+
+    def check(name, ok, detail):
+        results.append((name, ok))
+        print(f"{'PASS' if ok else 'FAIL'} {name}: {detail}")
+
+    # ── 关键词表完整性（15 词） ──
+    expect = [
+        "暂无", "没搜到", "没找到", "没有搜到", "没有找到",
+        "未查到", "未搜索到", "未查询到", "未找到",
+        "查不到", "不存在", "无相关", "无合适", "没有匹配", "搜索为空",
+    ]
+    check("关键词表 15 词完整", set(expect) == set(_NOT_FOUND_MARKERS), f"len={len(_NOT_FOUND_MARKERS)}")
+    check("含真实漏洞词「未搜索到」", "未搜索到" in _NOT_FOUND_MARKERS, "修复点")
+
+    # ── 命中语义（每条都要挂护栏） ──
+    hit_cases = [
+        "未搜索到相关商品。",          # 真实漏洞场景
+        "暂无商品信息",
+        "没有搜到相关商品",
+        "未查到该用户订单",
+        "平台暂时没有匹配的商品",
+        "不存在该商品",
+        "未查询到任何记录",
+        "没有找到合适的推荐",
+        "搜索为空，请换个关键词",
+        "查不到相关数据",
+        "无相关商品",
+    ]
+    for i, s in enumerate(hit_cases, 1):
+        g = _guard_result(s)
+        check(f"命中语义#{i}「{s[:12]}…」", _FORGE_GUARD in g and g.startswith(s), "护栏已挂")
+
+    # ── 非命中：正常结果不挂护栏 ──
+    ok_cases = [
+        "找到 3 款商品：轻量运动鞋 ¥299，库存充足。",
+        "订单状态：已发货，预计明日送达。",
+        "当前无优惠券可推荐（基础满减已计入）。",
+    ]
+    for i, s in enumerate(ok_cases, 1):
+        g = _guard_result(s)
+        check(f"正常结果不挂护栏#{i}", g == s and _FORGE_GUARD not in g, "原样返回")
+
+    # ── 空结果 / 异常 ──
+    g = _guard_result("")
+    check("空结果附加护栏", g.startswith("（工具未返回内容）") and _FORGE_GUARD in g, "空结果")
+    g = _guard_result(None)
+    check("None 附加护栏", _FORGE_GUARD in g, "None 安全")
+
+    passed = sum(1 for _, ok in results if ok)
+    print(f"\n===== 结果 {passed}/{len(results)} PASS =====")
+    sys.exit(0 if passed == len(results) else 1)
+
+
+if __name__ == "__main__":
+    main()
