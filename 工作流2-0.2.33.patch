+async def _http_get(url: str, timeout: float | None = None, headers: dict | None = None) -> dict[str, Any]:
+    """
+    执行 HTTP GET 并返回 JSON body。
 
+    工作流2 · 工具可靠性治理：
+    - 超时走配置（settings.ai_tool_timeout_s），调用方可显式覆盖（如比价/下单特例）；
+    - 只读 GET 幂等 → 5xx / 传输错误(TransportError) 按配置重试 ai_tool_retries 次，
+      间隔 ai_tool_retry_delay_s × attempt 线性递增；4xx 直接抛出不重试（非瞬时故障，重试无意义）。
+    """
+    timeout = timeout if timeout is not None else settings.ai_tool_timeout_s
+    retries = settings.ai_tool_retries
+    base_delay = settings.ai_tool_retry_delay_s
+    attempt = 0
+    while True:
+        try:
+            async with httpx.AsyncClient(timeout=timeout) as client:
+                resp = await client.get(url, headers=headers or {})
+                resp.raise_for_status()
+                return resp.json()
+        except (httpx.HTTPStatusError, httpx.HTTPError, httpx.TransportError) as e:
+            status_code = getattr(e, "response", None)
+            sc = status_code.status_code if status_code is not None else None
+            # 4xx：业务性/认证性错误，重试不会改变结果 → 立即抛出
+            if sc is not None and 400 <= sc < 500:
+                raise
+            if attempt >= retries:
+                logger.warning("GET 重试耗尽 url=%s attempt=%d err=%s", url, attempt, e)
+                raise
+            attempt += 1
+            delay = base_delay * attempt
+            logger.warning("GET 瞬时故障，%ss 后重试 url=%s attempt=%d err=%s", delay, url, attempt, e)
+            await asyncio.sleep(delay)
+
