# ── AI Orchestrator 环境变量 ──
# 复制为 .env 并修改

# LLM 配置
ZHIGOU_LLM_BASE_URL=https://api.openai.com/v1
ZHIGOU_LLM_API_KEY=sk-your-key-here
ZHIGOU_LLM_MODEL=gpt-4o-mini
ZHIGOU_LLM_TEMPERATURE=0.7

# 各服务地址（本地开发）
ZHIGOU_SEARCH_SERVICE_URL=http://localhost:8085
ZHIGOU_PRODUCT_SERVICE_URL=http://localhost:8083
ZHIGOU_INVENTORY_SERVICE_URL=http://localhost:8086
ZHIGOU_USER_SERVICE_URL=http://localhost:8081
ZHIGOU_MARKETING_SERVICE_URL=http://localhost:8087

# JWT 密钥（验证请求用）
ZHIGOU_JWT_SECRET=change-me-to-a-random-256-bit-string

# Embedding 模型
ZHIGOU_EMBEDDING_MODEL=text-embedding-v4

# PostgreSQL（pgvector）
ZHIGOU_PG_DSN=postgresql+asyncpg://zhigou:zhigou123@localhost:5432/zhigou_rag

# RocketMQ
ZHIGOU_ROCKETMQ_NAMESRV=localhost:9876