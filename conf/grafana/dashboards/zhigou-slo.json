{
  "title": "智购 · SLO 大盘",
  "uid": "zhigou-slo",
  "schemaVersion": 38,
  "version": 1,
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "错误预算剩余（可用性 99.9% · 30d）",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{
        "expr": "100 * (1 - sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[30d])) / sum(rate(http_server_requests_seconds_count[30d])) / 0.001)",
        "legendFormat": "预算剩余 %"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 50 },
              { "color": "yellow", "value": 20 },
              { "color": "red", "value": 0 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "可用性 30 天滚动",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{
        "expr": "100 - sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[30d])) / sum(rate(http_server_requests_seconds_count[30d])) * 100",
        "legendFormat": "30d 可用性 %"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 99.9 },
              { "color": "yellow", "value": 99 },
              { "color": "red", "value": 0 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 }
    },
    {
      "id": 3,
      "title": "可用性 7 天滚动",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{
        "expr": "100 - sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[7d])) / sum(rate(http_server_requests_seconds_count[7d])) * 100",
        "legendFormat": "7d 可用性 %"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 99.9 },
              { "color": "yellow", "value": 99 },
              { "color": "red", "value": 0 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 }
    },
    {
      "id": 4,
      "title": "错误率趋势（SLO < 0.5%）",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{
        "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count[5m])) * 100",
        "legendFormat": "错误率 %"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "red", "value": 0.5 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 }
    },
    {
      "id": 5,
      "title": "P95 延迟趋势（SLO < 1s）",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le, application))",
        "legendFormat": "{{application}} P95"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 }
    },
    {
      "id": 6,
      "title": "各服务 30 天可用性",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{
        "expr": "100 - sum by (application) (rate(http_server_requests_seconds_count{status=~\"5..\"}[30d])) / sum by (application) (rate(http_server_requests_seconds_count[30d])) * 100",
        "legendFormat": "{{application}}"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 99.9 },
              { "color": "yellow", "value": 99 },
              { "color": "red", "value": 0 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 }
    },
    {
      "id": 7,
      "title": "支付成功率（SLO ≥ 99.5%）",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{
        "expr": "sum(payment_success_total) / (sum(payment_success_total) + sum(payment_failed_total)) * 100",
        "legendFormat": "支付成功率 %"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 99.5 },
              { "color": "yellow", "value": 99 },
              { "color": "red", "value": 0 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 }
    }
  ],
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s"
}
