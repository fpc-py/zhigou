# ============================================================
# 智购 · 环境变量示例
# 复制为 .env 后填入真实值。.env 已在 .gitignore 中，不会提交。
# ============================================================

# --- 数据库 ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=zhigou
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- RocketMQ ---
ROCKETMQ_NAME_SERVER=localhost:9876

# --- MinIO ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin123

# --- JWT ---
JWT_SECRET=change-me-to-a-random-256-bit-string
JWT_ACCESS_EXPIRE_SECONDS=7200
JWT_REFRESH_EXPIRE_SECONDS=1209600

# --- 第三方（占位） ---
# SMS_ACCESS_KEY=
# SMS_SECRET_KEY=
# WECHAT_PAY_MCHID=
# WECHAT_PAY_API_V3_KEY=
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=